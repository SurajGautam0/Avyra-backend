<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consultant Dashboard - Avyra</title>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="app-layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo">Avyra</div>
        <span class="badge badge-consultant">Consultant</span>
      </div>
      <nav class="sidebar-nav">
        <a href="#" class="nav-item active" data-section="overview">
          <span class="nav-icon">&#9632;</span> Overview
        </a>
        <a href="#" class="nav-item" data-section="students">
          <span class="nav-icon">&#9632;</span> Students
        </a>
        <a href="#" class="nav-item" data-section="documents">
          <span class="nav-icon">&#9632;</span> Document Queue
        </a>
        <a href="#" class="nav-item" data-section="insights">
          <span class="nav-icon">&#9632;</span> Insights
        </a>
      </nav>
      <div class="sidebar-footer">
        <div class="user-info">
          <span id="consultantName">Consultant</span>
          <small id="consultantEmail"></small>
        </div>
        <button id="logoutBtn" class="btn btn-outline btn-sm">Logout</button>
      </div>
    </aside>
    <main class="main-content">
      <header class="topbar">
        <h2 id="pageTitle">Consultant Dashboard</h2>
        <div class="topbar-actions">
          <span id="lastUpdated"></span>
          <button id="refreshBtn" class="btn btn-outline btn-sm">&#8635; Refresh</button>
        </div>
      </header>

      <!-- Overview Section -->
      <section id="section-overview" class="section active">
        <div class="stats-grid">
          <div class="stat-card"><div class="stat-label">Total Students</div><div class="stat-value" id="statStudents">-</div></div>
          <div class="stat-card"><div class="stat-label">Active This Month</div><div class="stat-value" id="statActive">-</div></div>
          <div class="stat-card"><div class="stat-label">Pending Docs</div><div class="stat-value" id="statPendingDocs">-</div></div>
          <div class="stat-card"><div class="stat-label">Verified Docs</div><div class="stat-value" id="statVerifiedDocs">-</div></div>
        </div>

        <div class="chart-row">
          <div class="chart-card full">
            <h3>Student Applications by University</h3>
            <div class="bar-chart" id="uniApplicationsChart"></div>
          </div>
        </div>
      </section>

      <!-- Students Section -->
      <section id="section-students" class="section">
        <div class="table-card">
          <h3>My Students</h3>
          <div class="table-controls">
            <input type="text" id="studentSearch" placeholder="Search students..." class="search-input">
            <select id="studentStatusFilter" class="filter-select">
              <option value="">All Status</option>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>
          <div class="table-wrapper">
            <table id="studentsTable">
              <thead><tr><th>Name</th><th>Email</th><th>Country</th><th>Status</th><th>Progress</th><th>Action</th></tr></thead>
              <tbody id="studentsBody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Document Queue Section -->
      <section id="section-documents" class="section">
        <div class="table-card">
          <h3>Document Verification Queue</h3>
          <div class="table-wrapper">
            <table id="documentsTable">
              <thead><tr><th>Student</th><th>Document</th><th>Uploaded</th><th>AI Score</th><th>Action</th></tr></thead>
              <tbody id="documentsBody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Insights Section -->
      <section id="section-insights" class="section">
        <div class="chart-row">
          <div class="chart-card half">
            <h3>AI Insights Summary</h3>
            <div id="insightsSummary" class="insights-list"></div>
          </div>
          <div class="chart-card half">
            <h3>Performance Metrics</h3>
            <div id="performanceMetrics" class="insights-list"></div>
          </div>
        </div>
        <div class="chart-row">
          <div class="chart-card full">
            <h3>Recent Notes</h3>
            <div class="table-wrapper">
              <table id="notesTable">
                <thead><tr><th>Student</th><th>Note</th><th>Date</th></tr></thead>
                <tbody id="notesBody"></tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>
  <script src="/js/api.js"></script>
  <script src="/js/consultant-dashboard.js"></script>
</body>
</html>
