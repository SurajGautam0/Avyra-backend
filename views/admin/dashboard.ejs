<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Avyra</title>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
  <div class="app-layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo">EduBridge</div>
        <span class="badge badge-admin">Admin</span>
      </div>
      <nav class="sidebar-nav">
        <a href="#" class="nav-item active" data-section="overview">
          <span class="nav-icon">&#9632;</span> Dashboard
        </a>
        <a href="#" class="nav-item" data-section="students">
          <span class="nav-icon">&#9632;</span> Students
        </a>
        <a href="#" class="nav-item" data-section="consultants">
          <span class="nav-icon">&#9632;</span> Consultants
        </a>
        <a href="#" class="nav-item" data-section="universities">
          <span class="nav-icon">&#9632;</span> Universities
        </a>
        <a href="#" class="nav-item" data-section="applications">
          <span class="nav-icon">&#9632;</span> Applications
        </a>
        <a href="#" class="nav-item" data-section="payments">
          <span class="nav-icon">&#9632;</span> Payments
        </a>
        <a href="#" class="nav-item" data-section="reports">
          <span class="nav-icon">&#9632;</span> Reports
        </a>
        <a href="#" class="nav-item" data-section="content">
          <span class="nav-icon">&#9632;</span> Content Mgmt
        </a>
        <a href="#" class="nav-item" data-section="notifications">
          <span class="nav-icon">&#9632;</span> Notifications
        </a>
        <a href="#" class="nav-item" data-section="support">
          <span class="nav-icon">&#9632;</span> Support Tickets
        </a>
        <a href="#" class="nav-item" data-section="kyc">
          <span class="nav-icon">&#9632;</span> KYC Verification
        </a>
        <a href="#" class="nav-item" data-section="ai">
          <span class="nav-icon">&#9632;</span> AI Monitoring
        </a>
        <a href="#" class="nav-item" data-section="roles">
          <span class="nav-icon">&#9632;</span> Roles & Permissions
        </a>
        <a href="#" class="nav-item" data-section="audit">
          <span class="nav-icon">&#9632;</span> Audit Logs
        </a>
        <a href="#" class="nav-item" data-section="settings">
          <span class="nav-icon">&#9632;</span> Settings
        </a>
      </nav>
      <div class="sidebar-footer">
        <div class="user-info">
          <span id="adminName">Admin</span>
          <small id="adminEmail"></small>
        </div>
        <button id="logoutBtn" class="btn btn-outline btn-sm">Logout</button>
      </div>
    </aside>
    <main class="main-content">
      <header class="dashboard-header">
        <div class="header-copy">
          <span class="eyebrow">Admin Portal</span>
          <h1>Admin Dashboard</h1>
          <p class="dashboard-subtitle">EduBridge platform overview — July 2024</p>
        </div>
        <div class="header-actions">
          <span id="lastUpdated">Updated just now</span>
          <button id="refreshBtn" class="btn btn-outline btn-sm">Refresh</button>
        </div>
      </header>

      <section id="section-overview" class="section active overview-section">
        <div class="kpi-row">
          <div class="metric-card">
            <span class="metric-label">Total Users</span>
            <strong id="statTotalUsers">-</strong>
            <span class="metric-meta">+634 this month</span>
          </div>
          <div class="metric-card">
            <span class="metric-label">Total Universities</span>
            <strong id="statUniversities">-</strong>
            <span class="metric-meta">12 countries</span>
          </div>
          <div class="metric-card">
            <span class="metric-label">Total Consultants</span>
            <strong id="statConsultants">-</strong>
            <span class="metric-meta">96% verified</span>
          </div>
          <div class="metric-card">
            <span class="metric-label">Monthly Revenue</span>
            <strong id="statRevenue">-</strong>
            <span class="metric-meta">+13.6% MoM</span>
          </div>
        </div>

        <div class="mini-stats-row">
          <div class="mini-stat-card">
            <span>Active Applications</span>
            <strong id="statApplications">-</strong>
          </div>
          <div class="mini-stat-card">
            <span>Sessions Today</span>
            <strong id="statSessionsToday">-</strong>
          </div>
          <div class="mini-stat-card">
            <span>Support Tickets</span>
            <strong id="statSupportTickets">-</strong>
          </div>
          <div class="mini-stat-card">
            <span>Avg. Rating</span>
            <strong id="statRating">-</strong>
          </div>
        </div>

        <div class="dashboard-grid">
          <div class="chart-card chart-panel">
            <div class="panel-header">
              <h3>Revenue & User Growth</h3>
            </div>
            <div id="signupsChart" class="bar-chart"></div>
          </div>
          <div class="chart-card chart-panel">
            <div class="panel-header">
              <h3>Top Countries by Users</h3>
            </div>
            <div id="topCountries" class="country-list"></div>
          </div>
        </div>

        <div class="dashboard-grid dashboard-grid-2">
          <div class="activity-panel panel-card">
            <div class="panel-header">
              <h3>Recent Platform Activity</h3>
            </div>
            <div id="recentActivity" class="activity-list"></div>
          </div>
          <aside class="sidebar-panel">
            <div class="panel-card alert-panel">
              <div class="panel-header">
                <h3>System Alerts</h3>
              </div>
              <div class="alert-list">
                <div class="alert-item alert-info">High traffic detected — 634 users online</div>
                <div class="alert-item alert-warning">14 support tickets need attention</div>
                <div class="alert-item alert-danger">Payment gateway response time elevated</div>
              </div>
            </div>
            <div class="panel-card">
              <div class="panel-header">
                <h3>Popular Programs</h3>
              </div>
              <div id="popularPrograms" class="program-list"></div>
            </div>
          </aside>
        </div>
      </section>
    </main>
  </div>
  <script src="/js/api.js"></script>
  <script src="/js/admin-dashboard.js"></script>
</body>

</html>