<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Avyra</title>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <button class="mobile-toggle" id="mobileToggle">☰</button>
  <div class="app-layout">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <div class="logo"><span class="logo-gradient">Avyra</span></div>
        <span class="badge badge-admin">Admin</span>
      </div>
      <nav class="sidebar-nav">
        <a class="nav-item active" data-section="overview"><span class="nav-icon">📊</span> Dashboard</a>
        <a class="nav-item" data-section="students"><span class="nav-icon">👥</span> Students</a>
        <a class="nav-item" data-section="consultants"><span class="nav-icon">👨‍🏫</span> Consultants</a>
        <a class="nav-item" data-section="universities"><span class="nav-icon">🏛️</span> Universities</a>
        <a class="nav-item" data-section="applications"><span class="nav-icon">📋</span> Applications <span class="nav-badge">12</span></a>
        <a class="nav-item" data-section="kyc"><span class="nav-icon">✅</span> KYC Verification</a>
        <a class="nav-item" data-section="payments"><span class="nav-icon">💳</span> Payments</a>
        <a class="nav-item" data-section="ai"><span class="nav-icon">🤖</span> AI Monitoring</a>
        <a class="nav-item" data-section="roles"><span class="nav-icon">🔐</span> Roles & Permissions</a>
        <a class="nav-item" data-section="audit"><span class="nav-icon">📜</span> Audit Logs</a>
        <a class="nav-item" data-section="reports"><span class="nav-icon">📈</span> Reports</a>
        <a class="nav-item" data-section="support"><span class="nav-icon">🎫</span> Support Tickets</a>
        <a class="nav-item" data-section="settings"><span class="nav-icon">⚙️</span> Settings</a>
      </nav>
      <div class="sidebar-footer">
        <div class="avatar" id="adminAvatar">A</div>
        <div class="user-info">
          <span id="adminName">Admin</span>
          <small id="adminEmail"></small>
        </div>
        <button id="logoutBtn" class="btn btn-ghost btn-icon" title="Logout">🚪</button>
      </div>
    </aside>

    <main class="main-content">
      <div class="dashboard-header">
        <div class="header-left">
          <span class="eyebrow">Admin Portal</span>
          <h1>Dashboard</h1>
          <span class="subtitle">Platform overview and key metrics</span>
        </div>
        <div class="header-actions">
          <small id="lastUpdated">Updated just now</small>
          <button id="refreshBtn" class="btn btn-outline btn-sm">🔄 Refresh</button>
        </div>
      </div>

      <section id="section-overview" class="section active">
        <div class="kpi-row">
          <div class="metric-card">
            <div class="metric-icon" style="background:rgba(108,92,231,0.1);color:#6c5ce7;">👥</div>
            <span class="metric-label">Total Users</span>
            <div class="metric-value" id="statTotalUsers">-</div>
            <div class="metric-change up">↑ +634 this month</div>
            <div class="metric-bar"><span style="width:78%;background:#6c5ce7;"></span></div>
          </div>
          <div class="metric-card">
            <div class="metric-icon" style="background:rgba(0,184,148,0.1);color:#00b894;">🏛️</div>
            <span class="metric-label">Universities</span>
            <div class="metric-value" id="statUniversities">-</div>
            <div class="metric-change">· 12 countries</div>
            <div class="metric-bar"><span style="width:62%;background:#00b894;"></span></div>
          </div>
          <div class="metric-card">
            <div class="metric-icon" style="background:rgba(116,185,255,0.1);color:#0984e3;">👨‍🏫</div>
            <span class="metric-label">Consultants</span>
            <div class="metric-value" id="statConsultants">-</div>
            <div class="metric-change up">↑ 96% verified</div>
            <div class="metric-bar"><span style="width:96%;background:#0984e3;"></span></div>
          </div>
          <div class="metric-card">
            <div class="metric-icon" style="background:rgba(253,203,110,0.15);color:#b7950b;">💵</div>
            <span class="metric-label">Monthly Revenue</span>
            <div class="metric-value" id="statRevenue">-</div>
            <div class="metric-change up">↑ +13.6% MoM</div>
            <div class="metric-bar"><span style="width:58%;background:#fdcb6e;"></span></div>
          </div>
        </div>

        <div class="dashboard-grid cols-2">
          <div class="card">
            <div class="card-header">
              <h3>📈 Revenue & User Growth</h3>
            </div>
            <div class="card-body">
              <div id="signupsChart" class="bar-chart"></div>
            </div>
          </div>
          <div class="card">
            <div class="card-header">
              <h3>🌍 Top Countries</h3>
            </div>
            <div class="card-body">
              <div id="topCountries"></div>
            </div>
          </div>
        </div>

        <div class="dashboard-grid cols-1-2">
          <div class="card">
            <div class="card-header">
              <h3>⚡ Recent Activity</h3>
            </div>
            <div class="card-body">
              <div id="recentActivity" class="list"></div>
            </div>
          </div>
          <div class="card">
            <div class="card-header">
              <h3>🔔 System Alerts</h3>
            </div>
            <div class="card-body">
              <div class="alert-list">
                <div class="alert-item"><span class="alert-icon">ℹ️</span> High traffic detected — 634 users online</div>
                <div class="alert-item"><span class="alert-icon">⚠️</span> 14 support tickets need attention</div>
                <div class="alert-item"><span class="alert-icon">🔴</span> Payment gateway response time elevated</div>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h3>🔥 Popular Programs</h3>
          </div>
          <div class="card-body">
            <div id="popularPrograms" class="list"></div>
          </div>
        </div>
      </section>

      <section id="section-students" class="section">
        <div class="empty-state">
          <div class="empty-icon">👥</div>
          <h3>Student Management</h3>
          <p>Coming soon — full student CRUD and analytics</p>
        </div>
      </section>

      <section id="section-consultants" class="section">
        <div class="empty-state">
          <div class="empty-icon">👨‍🏫</div>
          <h3>Consultant Management</h3>
          <p>Coming soon — verify, manage and monitor consultants</p>
        </div>
      </section>

      <section id="section-universities" class="section">
        <div class="empty-state">
          <div class="empty-icon">🏛️</div>
          <h3>University Management</h3>
          <p>Coming soon — add, edit and track partner universities</p>
        </div>
      </section>

      <section id="section-applications" class="section">
        <div class="empty-state">
          <div class="empty-icon">📋</div>
          <h3>Applications</h3>
          <p>Coming soon — review and manage student applications</p>
        </div>
      </section>

      <section id="section-kyc" class="section">
        <div class="empty-state">
          <div class="empty-icon">✅</div>
          <h3>KYC Verification</h3>
          <p>Coming soon — verify user identities and documents</p>
        </div>
      </section>

      <section id="section-payments" class="section">
        <div class="empty-state">
          <div class="empty-icon">💳</div>
          <h3>Payments</h3>
          <p>Coming soon — transaction history and payout management</p>
        </div>
      </section>

      <section id="section-ai" class="section">
        <div class="empty-state">
          <div class="empty-icon">🤖</div>
          <h3>AI Monitoring</h3>
          <p>Coming soon — model performance and usage analytics</p>
        </div>
      </section>

      <section id="section-roles" class="section">
        <div class="empty-state">
          <div class="empty-icon">🔐</div>
          <h3>Roles & Permissions</h3>
          <p>Coming soon — role-based access control management</p>
        </div>
      </section>

      <section id="section-audit" class="section">
        <div class="empty-state">
          <div class="empty-icon">📜</div>
          <h3>Audit Logs</h3>
          <p>Coming soon — system activity and change tracking</p>
        </div>
      </section>

      <section id="section-reports" class="section">
        <div class="empty-state">
          <div class="empty-icon">📈</div>
          <h3>Reports</h3>
          <p>Coming soon — exportable analytics and custom reports</p>
        </div>
      </section>

      <section id="section-support" class="section">
        <div class="empty-state">
          <div class="empty-icon">🎫</div>
          <h3>Support Tickets</h3>
          <p>Coming soon — ticket management and resolution tracking</p>
        </div>
      </section>

      <section id="section-settings" class="section">
        <div class="empty-state">
          <div class="empty-icon">⚙️</div>
          <h3>Settings</h3>
          <p>Coming soon — platform configuration and preferences</p>
        </div>
      </section>
    </main>
  </div>
  <script src="/js/api.js"></script>
  <script src="/js/admin-dashboard.js"></script>
</body>
</html>
